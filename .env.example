# ===================================================================== #
# 红楼游园 · 环境变量样例
# 复制本文件为 .env（开发）或在 Vercel 控制台中配置（生产）。              #
# 所有 _KEY 都不进入 git，也不打包到产物。                                  #
# ===================================================================== #

# --- OpenAI GPT Image 2（必需：诗词意境图生成） ---------------------------
# 仅服务端使用（Vercel Functions），不要在浏览器里直接引用。
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Vercel 部署（仅当部署到 Vercel 时需要，Vercel CLI 会自动写入） -------
# 留空参考用：本地从未读取它。
VERCEL_OIDC_TOKEN=
